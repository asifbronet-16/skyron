/**
 * Finishes `next build` for CWP (Apache + PHP). Writes into out/:
 *   .htaccess            HTTPS, the canonical host, clean URLs and the old
 *                        WordPress redirects (a static export can't use
 *                        redirects() in next.config.ts)
 *   api/_lib/site.json   site details for the PHP form handlers
 * and, with --zip, packs out/ into dist/skytron.zip, ready to upload.
 *
 * Run by `npm run build` and `npm run package`. Node 22.18+ runs this
 * TypeScript as is. See DEPLOY-CWP.md.
 */
import { execFileSync } from "node:child_process";
import { existsSync, mkdirSync, rmSync, statSync, writeFileSync } from "node:fs";
import path from "node:path";
import { BLOG_POSTS, BLOG_POST_PAGES_LIVE } from "../constants/blogs.ts";
import { CV_MAX_BYTES, CV_MAX_MB } from "../constants/careers.ts";
import { CREATIVE_SOLUTIONS_ITEMS } from "../constants/creativeSolutions.ts";
import { SITE } from "../constants/site.ts";
import { TECHNOLOGY_SOLUTIONS_ITEMS } from "../constants/technologySolutions.ts";

const ROOT = path.resolve(import.meta.dirname, "..");
const OUT = path.join(ROOT, "out");
const ZIP = path.join(ROOT, "dist", "skytron.zip");

function fail(message: string): never {
  console.error(`\n[cwp-release] ${message}\n`);
  process.exit(1);
}

if (!existsSync(path.join(OUT, "index.html"))) fail("out/index.html not found: run `next build` first.");

// Escapes text for use inside a mod_rewrite (PCRE) pattern.
const rx = (text: string) => text.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");

type Redirect = [pattern: string, destination: string];

// Old WordPress URLs Google still crawls. The WP site served pages and posts
// at the root (/2d-content-creation/, /anamorphic-billboard-frame-by-frame)
// and date archives at /YYYY/MM/DD/. Order matters: first match wins.
// Patterns are mod_rewrite's: the path without its leading slash, matched
// with or without a trailing one.
function legacyWordPressRedirects(): Redirect[] {
  const postPath = (slug: string) => (BLOG_POST_PAGES_LIVE ? `/blogs/${slug}` : "/blogs");

  return [
    ...CREATIVE_SOLUTIONS_ITEMS.map((item): Redirect => [`^${rx(item.slug)}/?$`, `/creative-solutions/${item.slug}`]),
    ...TECHNOLOGY_SOLUTIONS_ITEMS.map((item): Redirect => [`^${rx(item.slug)}/?$`, `/technology-solutions/${item.slug}`]),
    ...BLOG_POSTS.map((post): Redirect => [`^${rx(post.slug)}/?$`, postPath(post.slug)]),
    // Date-style post permalinks for posts we still have.
    ...BLOG_POSTS.map((post): Redirect => [`^\\d{4}/\\d{2}/\\d{2}/${rx(post.slug)}/?$`, postPath(post.slug)]),
    // Until post pages exist, /blogs/<slug> (linked from the blog cards and
    // already indexed) 404s — send it to the listing. Only known slugs, so
    // this can never shadow a real post page later.
    ...(BLOG_POST_PAGES_LIVE
      ? []
      : BLOG_POSTS.map((post): Redirect => [`^blogs/${rx(post.slug)}/?$`, "/blogs"])),
    // Any other date archive or dated post: /2025, /2025/01, /2025/01/02/whatever.
    ["^\\d{4}(/.*)?$", "/blogs"],
  ];
}

const host = new URL(SITE.url).hostname;

const htaccess = `# ${SITE.name}: Apache config for the static build on CWP.
# GENERATED by scripts/cwp-release.mts on every build. Edit that, not this.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# Each page is a file like contact.html, often beside a contact/ folder of
# route data. Serve /contact as the page instead of redirecting to /contact/.
DirectorySlash Off

RewriteEngine On

# --- HTTPS, then the canonical host (${SITE.url}) ---
# The HTTPS hop keeps whatever host was asked for, so a staging address works.
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\\.${rx(host)}$ [NC]
RewriteRule ^ ${SITE.url}%{REQUEST_URI} [L,R=301]

# --- Form handler internals and PHP settings are not for the web ---
RewriteRule ^api/_lib(/|$) - [F,L]
RewriteRule (^|/)\\.user\\.ini$ - [F,L]

# --- Old WordPress URLs Google still crawls (first match wins) ---
${legacyWordPressRedirects()
  .map(([pattern, destination]) => `RewriteRule ${pattern} ${destination} [R=301,L]`)
  .join("\n")}

# --- Clean URLs: /contact/ redirects to /contact, which serves contact.html ---
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)/$ /$1 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ $1.html [L]

<IfModule mod_headers.c>
  # Build files carry a content hash in their names: cache them for a year.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Pages and their route data change with every deploy: always revalidate.
  <FilesMatch "\\.(html|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
`;

writeFileSync(path.join(OUT, ".htaccess"), htaccess);

// What the PHP handlers need from the site's constants (public/api/_lib/forms.php).
writeFileSync(
  path.join(OUT, "api", "_lib", "site.json"),
  `${JSON.stringify(
    {
      name: SITE.name,
      legalName: SITE.legalName,
      url: SITE.url,
      email: SITE.email,
      careersEmail: SITE.careersEmail,
      cvMaxMb: CV_MAX_MB,
      cvMaxBytes: CV_MAX_BYTES,
    },
    null,
    2
  )}\n`
);

// Everything the server needs, so a broken build never reaches a zip.
const REQUIRED = [
  ".htaccess",
  "index.html",
  "404.html",
  "api/.user.ini",
  "api/contact.php",
  "api/careers.php",
  "api/_lib/forms.php",
  "api/_lib/mail.php",
  "api/_lib/emails.php",
  "api/_lib/site.json",
];
const missing = REQUIRED.filter((file) => !existsSync(path.join(OUT, file)));
if (missing.length > 0) fail(`out/ is missing ${missing.join(", ")}.`);
console.log("[cwp-release] out/ is ready for CWP (.htaccess and api/_lib/site.json written).");

if (process.argv.includes("--zip")) {
  mkdirSync(path.dirname(ZIP), { recursive: true });
  rmSync(ZIP, { force: true });

  // The zip must use forward slashes, or Linux unzips "assets\x.js" as one
  // oddly named file instead of a folder. Windows' own tar.exe (bsdtar) does;
  // PowerShell's Compress-Archive doesn't, and Git Bash's GNU tar can't write
  // zips, hence the full path.
  const windowsTar = path.join(process.env.SystemRoot ?? "C:\\Windows", "System32", "tar.exe");
  const list =
    process.platform === "win32"
      ? () => {
          execFileSync(windowsTar, ["-a", "-c", "-f", ZIP, "-C", OUT, "."], { stdio: "inherit" });
          return execFileSync(windowsTar, ["-t", "-f", ZIP], { encoding: "utf8" });
        }
      : () => {
          execFileSync("zip", ["-q", "-r", "-X", ZIP, "."], { cwd: OUT, stdio: "inherit" });
          return execFileSync("unzip", ["-Z1", ZIP], { encoding: "utf8" });
        };
  const entries = list()
    .split(/\r?\n/)
    .filter(Boolean)
    .map((entry) => entry.replace(/^\.\//, ""));

  if (entries.some((entry) => entry.includes("\\"))) fail(`${ZIP} has backslash paths; don't upload it.`);
  const notZipped = REQUIRED.filter((file) => !entries.includes(file));
  if (notZipped.length > 0) fail(`${ZIP} is missing ${notZipped.join(", ")}.`);

  const mb = (statSync(ZIP).size / 1024 / 1024).toFixed(1);
  console.log(`[cwp-release] ${path.relative(ROOT, ZIP)}: ${entries.length} entries, ${mb} MB. Upload it to CWP (DEPLOY-CWP.md).`);
}
